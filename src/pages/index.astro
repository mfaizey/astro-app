---
import Base from "../layouts/Base.astro";
import Marquee from "../components/Marquee.astro";
import SectionHead from "../components/SectionHead.astro";
import WorkCard from "../components/WorkCard.astro";
import CTABand from "../components/CTABand.astro";
import { cases, engagements, stats, ticker, clients, process } from "../data/site";

const featured = cases.slice(0, 3);
---

<Base title="Growth collective & venture builder">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="pill" data-reveal>
        <span class="dot"></span> Taking on 3 ventures for Q1 · London / Lisbon / New York
      </span>

      <h1 class="display hero__title" style="margin-top: clamp(24px, 4vw, 48px)">
        <span class="line-mask"><span data-reveal="line" style="--delay:.05s">We build the</span></span>
        <span class="line-mask"><span data-reveal="line" style="--delay:.15s" class="acid">unfair</span></span>
        <span class="line-mask"><span data-reveal="line" style="--delay:.25s">advantage</span></span>
      </h1>

      <div class="hero__meta">
        <p class="lead" data-reveal>
          Not an agency. A collective of operators, creatives and engineers who
          co-build companies — and take the upside when they work.
        </p>
        <div data-reveal style="--delay:.1s">
          <p class="mono muted">Since 2016</p>
          <p class="mono muted" style="margin-top: 8px">47 ventures · 9 exits</p>
        </div>
      </div>

      <div class="hero__actions" data-reveal style="--delay:.15s">
        <a class="btn" href="/contact">Start a build <span class="arrow">→</span></a>
        <a class="btn btn--ghost" href="/work">See what we've shipped</a>
      </div>
    </div>
  </section>

  <Marquee items={ticker} />

  <!-- STATS -->
  <section class="section section--tight">
    <div class="container">
      <div class="grid grid--4">
        {
          stats.map((s, i) => (
            <div class="stat" data-reveal style={`--delay:${i * 0.08}s`}>
              <div
                class="stat__value acid"
                data-count={s.value}
                data-prefix={s.prefix ?? ""}
                data-suffix={s.suffix ?? ""}
              >
                {s.prefix ?? ""}{s.value}{s.suffix ?? ""}
              </div>
              <div class="stat__label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY NOT AN AGENCY -->
  <section class="section section--alt">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <span class="eyebrow">The difference</span>
          <h2 class="h2" style="margin-top: 22px">
            An agency sells you hours.<br />
            <span class="outline-text">We build you the edge.</span>
          </h2>
        </div>
        <div class="grid" style="gap: 0; --delay: .1s" data-reveal>
          <div class="card" style="border-radius: 0; border-inline: 0; border-top: 0">
            <p class="mono acid">01 — No account managers</p>
            <p class="h3" style="margin-top: 14px">You work with the people doing the work</p>
            <p class="muted" style="margin-top: 12px">
              Every pod is five to seven operators with total ownership. Nothing is
              relayed, nothing is diluted, nobody is waiting on a brief.
            </p>
          </div>
          <div class="card" style="border-radius: 0; border-inline: 0; border-top: 0">
            <p class="mono acid">02 — We carry the risk</p>
            <p class="h3" style="margin-top: 14px">Equity, hybrid, or performance-linked</p>
            <p class="muted" style="margin-top: 12px">
              We convert fees into ownership wherever we can. Our upside only exists
              if yours does — which is the whole point.
            </p>
          </div>
          <div class="card" style="border-radius: 0; border-inline: 0; border-top: 0; border-bottom: 0">
            <p class="mono acid">03 — We leave the engine behind</p>
            <p class="h3" style="margin-top: 14px">Designed to be outgrown</p>
            <p class="muted" style="margin-top: 12px">
              Every engagement ends with a documented, instrumented system your team
              runs without us. Dependency is a failure state.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ENGAGEMENTS -->
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="How we engage"
        title="Four ways in. None of them are retainers that go nowhere."
        copy="Pick the model that matches where the company actually is — from first launch to scaling distribution."
      />

      <div class="rows">
        {
          engagements.map((e, i) => (
            <a class="row" href="/engagements" data-reveal style={`--delay:${i * 0.06}s`}>
              <span class="row__num">{e.index}</span>
              <span>
                <span class="row__title">{e.title}</span>
                <span class="muted" style="display: block; margin-top: 10px; max-width: 60ch">
                  {e.short}
                </span>
              </span>
              <span class="row__meta">{e.model}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FEATURED WORK -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead
        eyebrow="Selected work"
        title="Companies we built, not campaigns we ran."
        copy="Six of forty-seven. Each one started with a problem nobody wanted to own."
      />
      <div class="grid grid--3">
        {featured.map((item, i) => <WorkCard item={item} index={i} />)}
      </div>
      <div style="margin-top: clamp(32px, 4vw, 56px)" data-reveal>
        <a class="btn btn--ghost" href="/work">All case studies <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="The machine"
        title="Diagnose. Design. Deploy. Hand over."
        copy="One pod, one plan, one scoreboard. Four phases, no theatre."
      />
      <div class="grid grid--4">
        {
          process.map((p, i) => (
            <div class="card card--flat" data-reveal style={`--delay:${i * 0.07}s`}>
              <div class="big-number">{p.n}</div>
              <h3 class="h3" style="margin-top: 24px">{p.title}</h3>
              <p class="muted" style="margin-top: 12px">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Marquee items={clients} speed="52s" />

  <CTABand
    title="If the outcome isn't unfair, we haven't done our job."
    copy="Tell us what you're building. Two weeks from now you'll have a diagnosis, a plan and a pod — or an honest no."
  />
</Base>
